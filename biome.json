{
    "files": {
        "includes": ["src/**", "*.json", "!package-lock.json"]
    },
    "formatter": {
        "bracketSpacing": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineEnding": "lf"
    },
    "javascript": {
        "formatter": {
            "semicolons": "asNeeded"
        }
    },
    "linter": {
        "rules": {
            "preset": "recommended",
            "complexity": {
                "useLiteralKeys": "off"
            },
            "style": {
                "noDefaultExport": "error",
                "useBlockStatements": "error"
            },
            "nursery": {
                "useImportsFirst": "error"
            }
        }
    }
}
